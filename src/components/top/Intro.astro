---
import Icon from "../../assets/icon-wowazun.astro";
import ScrollNavigation from "../design/ScrollNavigation.astro";
import GitHubIcon from "../../assets/GitHub.png";
---

<div class="flex justify-center pt-[10vh] z-10">
  <div class="flex flex-col h-screen">
    <div
      class="flex items-center flex-col md:flex-row justify-center gap-4 md:gap-8"
    >
      <div class="w-[clamp(200px,30vw,320px)]">
        <Icon />
      </div>

      <div class="flex flex-col items-center md:items-start">
        <h1
          class="text-6xl md:text-8xl font-['Itim'] font-extrabold text-gray-900"
        >
          wowazun
        </h1>
        <p class="text-lg md:text-2xl font-semibold md:ml-1 text-gray-800">
          電気通信大学 情報理工学域
        </p>
        <div class="flex-col mt-2">
          <a href="https://github.com/wowazun">
            <img src={GitHubIcon.src} alt="GitHub" class="w-7" />
          </a>
        </div>
      </div>
    </div>
    <div class="flex justify-center mt-auto mb-20 md:mb-50">
      <ScrollNavigation />
    </div>
  </div>
</div>
