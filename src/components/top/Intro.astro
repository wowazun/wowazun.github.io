---
import icon from "../../assets/icon-wowazun.svg";
---

<div class="flex min-h-screen justify-center z-10">
  <div class="flex items-center gap-4 md:gap-8">
    <img src={icon.src} alt="wowazun のアイコン" class="w-30 md:w-80" />

    <div class="flex flex-col">
      <h1
        class="text-4xl md:text-8xl font-['Itim'] font-extrabold text-gray-900"
      >
        wowazun
      </h1>
      <p class="text-sm md:text-2xl font-semibold mt-2 text-gray-800">
        電気通信大学 情報理工学域
      </p>
    </div>
  </div>
</div>
